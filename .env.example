LINEAR_API_KEY=
LINEAR_TEAM_KEY=PP
CLAUDE_BIN=claude
CLAUDE_MODEL=
SKIP_PERMISSIONS=true
WAITING_AFTER_SECONDS=20
PORT=8770
MAX_BUILDERS=3
MAX_LIVE_BUILDERS=6
PARK_AFTER_SECONDS=900
WAITING_CLOSE_SECONDS=3600
RESUME_ALL_ON_LAUNCH=false
AUTO_REBASE=false
# GitHub login whose PRs builders work on; empty means the login gh runs as. PRs by anyone else are left alone.
GITHUB_LOGIN=
# Hold the Mac awake (caffeinate -i) while builders are working, so it cannot sleep mid-response.
KEEP_AWAKE=true
REBASE_POLL_SECONDS=60
AUTO_COMMENTS=true
COMMENT_POLL_SECONDS=300
AUTO_REQUEUE=true
